SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=sqlite
# For PostgreSQL, set DB_ENGINE=postgresql and configure the values below.
DB_NAME=cotacao
DB_USER=cotacao
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
# Configure a mail provider before production use.
DEFAULT_FROM_EMAIL=Cotação Pro <nao-responda@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
